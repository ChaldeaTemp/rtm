{
  "name": "rtm",
  "version": "0.1.0",
  "description": "RTM (Round Table Meeting): a local workbench where several CLI coding agents work on one task together, built on ACP",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "rtm": "./dist/index.js",
    "agent-hub": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "ui": "tsx src/index.ts --ui",
    "desktop": "tsx src/index.ts desktop",
    "status": "tsx src/index.ts status",
    "verify": "tsx scripts/verify-phase1.ts",
    "verify:phase2-3": "tsx scripts/verify-phase2-3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "verify:phase7": "tsx scripts/verify-phase7.ts",
    "verify:phase8": "tsx scripts/verify-phase8.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "latest",
    "@agentclientprotocol/codex-acp": "latest",
    "@agentclientprotocol/sdk": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "acpx": "latest",
    "mermaid": "^11.17.2",
    "ws": "^8.18.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "latest",
    "typescript": "^5.7.0"
  }
}
