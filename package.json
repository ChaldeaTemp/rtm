{
  "name": "rtm",
  "version": "0.1.0",
  "description": "RTM (Round Table Meeting): a local workbench where several CLI coding agents work on one task together, built on ACP",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "rtm": "./dist/index.js",
    "agent-hub": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "ui": "tsx src/index.ts --ui",
    "desktop": "tsx src/index.ts desktop",
    "shortcut": "tsx src/index.ts shortcut",
    "status": "tsx src/index.ts status",
    "verify": "tsx scripts/verify-phase1.ts",
    "verify:phase2-3": "tsx scripts/verify-phase2-3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "verify:phase7": "tsx scripts/verify-phase7.ts",
    "verify:phase8": "tsx scripts/verify-phase8.ts",
    "verify:walkthrough": "tsx scripts/verify-walkthrough.ts",
    "verify:robustness": "tsx scripts/verify-robustness.ts",
    "verify:board": "tsx scripts/verify-board.ts",
    "verify:classic-board": "tsx scripts/verify-classic-board.ts",
    "verify:scene-config": "tsx scripts/verify-scene-config.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "fixture:classic-board": "tsx scripts/fixture-classic-board.ts",
    "verify:mock": "tsc --noEmit && tsx scripts/verify-walkthrough.ts && tsx scripts/verify-robustness.ts && tsx scripts/verify-board.ts && tsx scripts/verify-classic-board.ts && tsx scripts/verify-scene-config.ts && tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.106.0",
    "@agentclientprotocol/codex-acp": "^2.6.0",
    "@agentclientprotocol/sdk": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "acpx": "^0.22.0",
    "mermaid": "^11.17.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
